rules_version = '2';

// Kava Hub security rules.
// - Every signed-in session carries a `loc` claim (set by the pinLogin function).
// - A person's access is read live from their user doc + role doc, so changing
//   someone's role, access, or deactivating them takes effect immediately.
// - Access levels per tool: 0 hidden, 1 use, 2 manage. Owner = everything.
service cloud.firestore {
  match /databases/{database}/documents {

    function userPath(loc) {
      return /databases/$(database)/documents/locations/$(loc)/users/$(request.auth.uid);
    }
    function me(loc) { return get(userPath(loc)).data; }

    function member(loc) {
      return request.auth != null
        && request.auth.token.loc == loc
        && exists(userPath(loc))
        && me(loc).active == true;
    }

    function isOwner(loc) { return member(loc) && me(loc).roleId == 'owner'; }

    function level(loc, tool) {
      let u = me(loc);
      let role = get(/databases/$(database)/documents/locations/$(loc)/roles/$(u.roleId)).data;
      let ov = u.get('overrides', {});
      return u.roleId == 'owner' ? 2
        : (ov.keys().hasAny([tool]) ? ov[tool] : role.get('perms', {}).get(tool, 0));
    }

    function can(loc, tool, lvl) { return member(loc) && level(loc, tool) >= lvl; }

    match /locations/{loc} {
      allow read: if member(loc);
      allow update: if isOwner(loc)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'settings']);
      allow create, delete: if false;

      // People: you can read yourself; admins can read everyone. Changes go through functions.
      match /users/{uid} {
        // Managers on Side Quests can see the staff list too, to give stars by hand.
        allow read: if member(loc) && (uid == request.auth.uid || can(loc, 'admin', 2) || can(loc, 'quests', 2));
        allow write: if false;
      }

      // Roles: everyone signed in can read (the app needs them to work out access).
      // Only an Owner edits a role's name and access grid. Create/delete go through functions.
      match /roles/{roleId} {
        allow read: if member(loc);
        allow update: if isOwner(loc) && roleId != 'owner'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'perms'])
          && request.resource.data.name is string
          && request.resource.data.perms is map;
        allow create, delete: if false;
      }

      // Tile settings (on/off + order).
      match /tools/{toolId} {
        allow read: if member(loc);
        allow create, update: if can(loc, 'admin', 2)
          && request.resource.data.keys().hasOnly(['enabled', 'order'])
          && request.resource.data.enabled is bool
          && request.resource.data.order is int;
        allow delete: if false;
      }

      // Activity log: anyone signed in can add an entry as themselves; only admins read it.
      match /activity/{id} {
        allow read: if can(loc, 'admin', 2);
        allow create: if member(loc)
          && request.resource.data.keys().hasOnly(['at', 'actorUid', 'actorName', 'tool', 'action', 'detail'])
          && request.resource.data.actorUid == request.auth.uid
          && request.resource.data.actorName == me(loc).name
          && request.resource.data.at == request.time
          && request.resource.data.tool is string && request.resource.data.tool.size() <= 40
          && request.resource.data.action is string && request.resource.data.action.size() <= 80
          && request.resource.data.detail is string && request.resource.data.detail.size() <= 300;
        allow update, delete: if false;
      }

      // ---- Tool data ----
      // Each tool keeps its data under locations/{loc}/tools-data/{toolId}/...
      // and adds its own match block here when it's built.

      // Suggestion Box: everyone with Use sees the board and posts under their own name.
      // Manage sets status / replies and can remove anything. Authors can delete their own
      // post while it's still "new".
      match /tools-data/suggestions/items/{id} {
        allow read: if can(loc, 'suggestions', 1);
        allow create: if can(loc, 'suggestions', 1)
          && request.resource.data.keys().hasOnly(['text', 'authorUid', 'authorName', 'createdAt', 'status'])
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.authorName == me(loc).name
          && request.resource.data.createdAt == request.time
          && request.resource.data.status == 'new'
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000;
        allow update: if can(loc, 'suggestions', 2)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'response', 'respondedBy', 'respondedAt'])
          && request.resource.data.status in ['new', 'reviewing', 'planned', 'done', 'declined']
          && request.resource.data.response is string && request.resource.data.response.size() <= 1000
          && request.resource.data.respondedBy == me(loc).name
          && request.resource.data.respondedAt == request.time;
        allow delete: if can(loc, 'suggestions', 2)
          || (can(loc, 'suggestions', 1) && resource.data.authorUid == request.auth.uid && resource.data.status == 'new');
      }

      // TV Screens: what the TVs show. Anyone can read it (the TVs aren't signed in, and it's
      // shown on public screens anyway). Manage on TV Screens edits everything; a role given a
      // section in TV Screens > Permissions can edit that section. Until permissions are set,
      // anyone with Use can edit "crew" (who's working).
      match /tv/{docId} {
        function tvConfigPath() { return /databases/$(database)/documents/locations/$(loc)/tv/config; }
        function sectionEditor(section) {
          return can(loc, 'tv', 2)
            || (can(loc, 'tv', 1) && (exists(tvConfigPath())
                  ? get(tvConfigPath()).data.get('perms', {}).get(section, []).hasAny([me(loc).roleId])
                  : section == 'crew'));
        }
        allow read: if true;
        allow write: if (docId == 'config' && can(loc, 'tv', 2))
          || (docId in ['crew', 'events', 'happyhour', 'specials', 'signature', 'products', 'community', 'ticker', 'welcome', 'qr']
              && sectionEditor(docId));
      }

      // Side Quests: the board of extra jobs. Use sees the board and signs off ("I did it",
      // optional photo) in their own name; Manage adds quests and approves or sends back sign-offs.
      // A quest can be set to unlock on a date (e.g. taking down seasonal decorations).
      // Each approved sign-off is a star.
      match /tools-data/quests/items/{id} {
        function validQuest(d) {
          return d.title is string && d.title.size() > 0 && d.title.size() <= 120
            && d.details is string && d.details.size() <= 1000
            && d.repeat is bool && d.open is bool
            && d.get('stars', 1) is int && d.get('stars', 1) >= 1 && d.get('stars', 1) <= 5
            && d.get('unlockOn', '') is string && d.get('unlockOn', '').size() <= 10
            && (d.get('unlockAt', null) == null || d.get('unlockAt', null) is timestamp)
            && d.updatedAt == request.time && d.updatedBy == me(loc).name;
        }
        allow read: if can(loc, 'quests', 1);
        allow create: if can(loc, 'quests', 2)
          && request.resource.data.keys().hasOnly(['title', 'details', 'repeat', 'open', 'stars', 'unlockOn', 'unlockAt', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
          && request.resource.data.createdAt == request.time
          && request.resource.data.createdBy == me(loc).name
          && validQuest(request.resource.data);
        allow update: if can(loc, 'quests', 2)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'details', 'repeat', 'open', 'stars', 'unlockOn', 'unlockAt', 'updatedAt', 'updatedBy'])
          && validQuest(request.resource.data);
        allow delete: if can(loc, 'quests', 2);
      }
      match /tools-data/quests/subs/{id} {
        function questPath(qid) { return /databases/$(database)/documents/locations/$(loc)/tools-data/quests/items/$(qid); }
        function userPathOf(uid) { return /databases/$(database)/documents/locations/$(loc)/users/$(uid); }
        // Manage can also give (or take back) stars by hand: an already-approved record with a star count.
        function validManual(d) {
          return d.keys().hasOnly(['kind', 'questId', 'questTitle', 'uid', 'name', 'note', 'photo', 'at', 'status', 'stars', 'reviewedBy', 'reviewedAt', 'reviewNote'])
            && d.kind == 'manual' && d.status == 'approved'
            && d.stars is int && d.stars != 0 && d.stars >= -500 && d.stars <= 500
            && d.uid is string && exists(userPathOf(d.uid)) && d.name == get(userPathOf(d.uid)).data.name
            && d.questId == '' && d.note == '' && d.photo == '' && d.reviewNote == ''
            && d.questTitle is string && d.questTitle.size() > 0 && d.questTitle.size() <= 120
            && d.at == request.time && d.reviewedAt == request.time && d.reviewedBy == me(loc).name;
        }
        // A sign-off carries the quest's star value (changing a quest later doesn't change past stars),
        // and quests set to unlock on a date can't be signed off before then.
        allow read: if can(loc, 'quests', 1);
        allow create: if (can(loc, 'quests', 2) && validManual(request.resource.data)) || (can(loc, 'quests', 1)
          && request.resource.data.keys().hasOnly(['questId', 'questTitle', 'uid', 'name', 'note', 'photo', 'at', 'status', 'stars'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.name == me(loc).name
          && request.resource.data.at == request.time
          && request.resource.data.status == 'pending'
          && request.resource.data.questId is string && request.resource.data.questId.size() <= 60
          && request.resource.data.questTitle is string && request.resource.data.questTitle.size() <= 120
          && request.resource.data.note is string && request.resource.data.note.size() <= 500
          && request.resource.data.photo is string
          && (request.resource.data.photo == '' || request.resource.data.photo.matches('^/[.]netlify/functions/hub[?]media=[a-z0-9.-]+$'))
          && exists(questPath(request.resource.data.questId))
          && get(questPath(request.resource.data.questId)).data.open == true
          && request.resource.data.get('stars', 1) == get(questPath(request.resource.data.questId)).data.get('stars', 1)
          && (get(questPath(request.resource.data.questId)).data.get('unlockAt', null) == null
              || get(questPath(request.resource.data.questId)).data.get('unlockAt', null) <= request.time));
        allow update: if can(loc, 'quests', 2)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewNote', 'reviewedBy', 'reviewedAt'])
          && request.resource.data.status in ['approved', 'rejected']
          && request.resource.data.reviewNote is string && request.resource.data.reviewNote.size() <= 300
          && request.resource.data.reviewedBy == me(loc).name
          && request.resource.data.reviewedAt == request.time;
        allow delete: if can(loc, 'quests', 2)
          || (can(loc, 'quests', 1) && resource.data.uid == request.auth.uid && resource.data.status == 'pending');
      }

      // Menu Maker: anyone with Use makes, edits and prints menus; they can delete their own.
      // Manage can delete any menu.
      match /tools-data/menus/items/{id} {
        function validMenu(d) {
          return d.title is string && d.title.size() > 0 && d.title.size() <= 80
            && d.event is string && d.event.size() <= 80
            && d.address is string && d.address.size() <= 120
            && d.tagline is string && d.tagline.size() <= 60
            && d.footer is string && d.footer.size() <= 160
            && d.paper in ['letter', 'half']
            && d.sections is list && d.sections.size() <= 8
            && d.updatedAt == request.time && d.updatedBy == me(loc).name;
        }
        allow read: if can(loc, 'menus', 1);
        allow create: if can(loc, 'menus', 1)
          && request.resource.data.keys().hasOnly(['title', 'event', 'address', 'tagline', 'footer', 'paper', 'sections', 'updatedAt', 'updatedBy', 'createdAt', 'createdBy', 'createdUid'])
          && request.resource.data.createdAt == request.time
          && request.resource.data.createdBy == me(loc).name
          && request.resource.data.createdUid == request.auth.uid
          && validMenu(request.resource.data);
        allow update: if can(loc, 'menus', 1)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'event', 'address', 'tagline', 'footer', 'paper', 'sections', 'updatedAt', 'updatedBy'])
          && validMenu(request.resource.data);
        allow delete: if can(loc, 'menus', 2) || (can(loc, 'menus', 1) && resource.data.createdUid == request.auth.uid);
      }

      // Knowledge Bank: Use reads; Manage writes, edits and deletes.
      match /tools-data/knowledge/articles/{id} {
        function validArticle(d) {
          return d.title is string && d.title.size() > 0 && d.title.size() <= 120
            && d.category is string && d.category.size() <= 40
            && d.body is string && d.body.size() > 0 && d.body.size() <= 20000
            && d.updatedAt == request.time
            && d.updatedBy == me(loc).name;
        }
        allow read: if can(loc, 'knowledge', 1);
        allow create: if can(loc, 'knowledge', 2)
          && request.resource.data.keys().hasOnly(['title', 'category', 'body', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
          && request.resource.data.createdAt == request.time
          && request.resource.data.createdBy == me(loc).name
          && validArticle(request.resource.data);
        allow update: if can(loc, 'knowledge', 2)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'category', 'body', 'updatedAt', 'updatedBy'])
          && validArticle(request.resource.data);
        allow delete: if can(loc, 'knowledge', 2);
      }

      // Opening & Closing checklists.
      // The three lists (opening / shift / closing): everyone with Use reads them; Manage edits.
      match /tools-data/checklists/lists/{listId} {
        allow read: if can(loc, 'checklists', 1);
        allow write: if can(loc, 'checklists', 2)
          && listId in ['opening', 'shift', 'closing']
          && request.resource.data.keys().hasOnly(['name', 'items'])
          && request.resource.data.name is string && request.resource.data.name.size() <= 40
          && request.resource.data.items is list && request.resource.data.items.size() <= 150;
      }

      // One document per business day per list ("2026-10-20_closing"), holding who checked what.
      // - Manage can read every day (history). Use can read only the last ~2 days
      //   (today + last night's close).
      // - A write either changes exactly one item (named in lastItem) or records a Submit.
      //   Checks and submits must be in your own name and stamped with the server's time;
      //   anyone can uncheck. Only today's lists can be changed.
      match /tools-data/checklists/days/{dayId} {
        function recentDay(d) { return d.dayStart > request.time - duration.value(60, 'h'); }
        function validDay(d) {
          return d.keys().hasOnly(['date', 'listId', 'listName', 'dayStart', 'items', 'checks', 'lastItem', 'submitted', 'updatedAt'])
            && d.listId in ['opening', 'shift', 'closing']
            && dayId == d.date + '_' + d.listId
            && d.dayStart is timestamp
            && d.dayStart > request.time - duration.value(36, 'h')
            && d.dayStart < request.time + duration.value(12, 'h')
            && d.listName is string && d.listName.size() <= 40
            && d.items is list && d.items.size() <= 150
            && d.checks is map
            && d.updatedAt == request.time;
        }
        // Exactly one item changed, and it's the one named in lastItem.
        function oneCheck(before) {
          let d = request.resource.data;
          let k = d.get('lastItem', null);
          let changed = d.checks.diff(before).affectedKeys();
          return k is string
            && changed.size() == 1
            && changed.hasOnly([k])
            && (!(k in d.checks)
              || (d.checks[k].byUid == request.auth.uid
                && d.checks[k].by == me(loc).name
                && d.checks[k].at == request.time
                && d.checks[k].text is string && d.checks[k].text.size() <= 200));
        }
        function validSubmit(s) {
          return s is map
            && s.keys().hasOnly(['by', 'byUid', 'at', 'done', 'total', 'skippedCritical'])
            && s.byUid == request.auth.uid
            && s.by == me(loc).name
            && s.at == request.time
            && s.done is int && s.total is int
            && s.skippedCritical is list && s.skippedCritical.size() <= 150;
        }
        allow read: if can(loc, 'checklists', 2)
          || (can(loc, 'checklists', 1) && (resource == null || recentDay(resource.data)));
        allow create: if can(loc, 'checklists', 1)
          && validDay(request.resource.data)
          && ((oneCheck({}) && !('submitted' in request.resource.data))
            || (request.resource.data.checks.size() == 0 && validSubmit(request.resource.data.get('submitted', null))));
        allow update: if can(loc, 'checklists', 1)
          && validDay(request.resource.data)
          && request.resource.data.dayStart == resource.data.dayStart
          && request.resource.data.date == resource.data.date
          && ((oneCheck(resource.data.checks)
                && request.resource.data.get('submitted', null) == resource.data.get('submitted', null))
            || (request.resource.data.checks == resource.data.checks
                && validSubmit(request.resource.data.get('submitted', null))));
        allow delete: if false;
      }
    }

    // pinIndex and anything not listed above: server only.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
